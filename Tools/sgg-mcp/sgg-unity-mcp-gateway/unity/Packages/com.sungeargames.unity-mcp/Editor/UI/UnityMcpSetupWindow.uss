.mcp-window {
    --mcp-accent: rgba(255, 208, 92, 0.95);
    --mcp-info: #a99be6;
    --mcp-ok: #006397;
    --mcp-warn: #f2ab06;
    --mcp-optional: #d6b449;
    --mcp-error: #ed0000;
    --mcp-panel: #2d2d2d;
    --mcp-panel-dark: #252525;
    --mcp-panel-header: rgb(30, 40, 40);
    --mcp-panel-border: rgb(30, 40, 40);
    --mcp-text-muted: #a8a8a8;
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.mcp-title {
    background-color: #383838;
    color: #f2f2f2;
    font-size: 15px;
    -unity-font-style: bold;
    padding-top: 7px;
    padding-right: 10px;
    padding-bottom: 7px;
    padding-left: 10px;
    margin-bottom: 8px;
}

.mcp-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    height: auto;
    overflow: visible;
    margin-bottom: 8px;
}

.mcp-header-shortcuts {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: -4px;
    margin-bottom: 6px;
}

.mcp-tab {
    min-width: 110px;
    flex-shrink: 0;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.mcp-tab:checked {
    border-bottom-width: 2px;
    border-bottom-color: var(--mcp-accent);
    color: var(--mcp-accent);
}

.mcp-section {
    border-width: 1px;
    border-color: var(--mcp-panel-border);
    padding-top: 1px;
    padding-right: 1px;
    padding-bottom: 1px;
    padding-left: 1px;
    margin-bottom: 8px;
}

.mcp-section-caption {
    background-color: var(--mcp-panel-header);
    color: rgb(80, 140, 140);
    font-size: 14px;
    -unity-font-style: bold;
    padding-top: 5px;
    padding-right: 8px;
    padding-bottom: 5px;
    padding-left: 8px;
}

.mcp-section-content {
    background-color: rgba(0, 0, 0, 0.06);
    padding-top: 7px;
    padding-right: 7px;
    padding-bottom: 7px;
    padding-left: 7px;
}

.mcp-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 4px;
    min-width: 0;
}

.mcp-help-row {
    white-space: normal;
    color: var(--mcp-text-muted);
    background-color: rgba(255, 255, 255, 0.04);
    border-left-width: 2px;
    border-left-color: var(--mcp-info);
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    margin-bottom: 8px;
}

.mcp-input-row {
    margin-bottom: 4px;
}

.mcp-input-field {
    min-width: 0;
}

.mcp-history-progress {
    height: 24px;
    margin-top: 3px;
    margin-bottom: 5px;
}

.mcp-history-full .unity-progress-bar__progress {
    background-color: var(--mcp-error);
}

.mcp-history-settings {
    border-left-width: 2px;
    border-left-color: var(--mcp-info);
    padding-left: 8px;
    margin-top: 6px;
}

.mcp-policy-editor-field {
    min-height: 58px;
}

.mcp-secret-row {
    border-left-width: 2px;
    border-left-color: rgba(255, 255, 255, 0.18);
}

.mcp-status-optional {
    color: var(--mcp-text-muted);
}

.mcp-checklist-row {
    margin-bottom: 5px;
}

.mcp-checklist-field {
    flex-direction: row;
    align-items: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    background-color: rgba(20, 20, 20, 0.45);
    border-left-width: 3px;
    border-left-color: var(--mcp-warn);
    padding-top: 3px;
    padding-right: 6px;
    padding-bottom: 3px;
    padding-left: 4px;
}

.mcp-checklist-icon {
    width: 22px;
    min-width: 22px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

.mcp-checklist-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
}

.mcp-checklist--ok {
    border-left-color: var(--mcp-ok);
}

.mcp-checklist--warn {
    border-left-color: var(--mcp-warn);
}

.mcp-checklist--error {
    border-left-color: var(--mcp-error);
}

.mcp-checklist--optional {
    border-left-color: var(--mcp-optional);
}

.mcp-checklist--info {
    border-left-color: var(--mcp-info);
}

.mcp-checklist--loading {
    border-left-color: var(--mcp-info);
}

.mcp-checklist-icon--ok {
    color: var(--mcp-ok);
}

.mcp-checklist-icon--warn {
    color: var(--mcp-warn);
}

.mcp-checklist-icon--error {
    color: var(--mcp-error);
}

.mcp-checklist-icon--optional {
    color: var(--mcp-optional);
}

.mcp-checklist-icon--info {
    color: var(--mcp-info);
}

.mcp-checklist-icon--loading {
    color: var(--mcp-info);
}

.mcp-unity-tool-row .mcp-checklist--ok .mcp-checklist-value { color: var(--mcp-ok); }
.mcp-unity-tool-row .mcp-checklist--error .mcp-checklist-value { color: var(--mcp-error); }
.mcp-unity-tool-row .mcp-checklist--optional .mcp-checklist-value { color: var(--mcp-optional); }
.mcp-unity-tool-row .mcp-checklist--info .mcp-checklist-value { color: var(--mcp-info); }

.mcp-key {
    width: 128px;
    min-width: 128px;
    margin-right: 6px;
    color: var(--mcp-text-muted);
    white-space: normal;
}

.mcp-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: normal;
    background-color: rgba(20, 20, 20, 0.35);
    border-left-width: 2px;
    border-left-color: var(--mcp-info);
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
}

.mcp-copy-button {
    width: 24px;
    min-width: 24px;
    height: 22px;
    margin-left: 4px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
    align-items: center;
    justify-content: center;
    color: #b3b3b3;
}

.mcp-copy-icon {
    position: relative;
    width: 14px;
    height: 14px;
}

.mcp-copy-icon-back {
    position: absolute;
    left: 5px;
    top: 1px;
    width: 7px;
    height: 9px;
    border-width: 1px;
    border-color: #b3b3b3;
    background-color: rgba(0, 0, 0, 0);
}

.mcp-copy-icon-front {
    position: absolute;
    left: 2px;
    top: 4px;
    width: 7px;
    height: 9px;
    border-width: 1px;
    border-color: #b3b3b3;
    background-color: rgba(0, 0, 0, 0);
}

.mcp-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.mcp-action-row {
    align-items: flex-start;
}

.mcp-danger-row .mcp-value {
    border-left-color: var(--mcp-error);
}

.mcp-button {
    min-width: 140px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.mcp-header-shortcut-button {
    min-width: 34px;
    height: 22px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: middle-center;
}

.mcp-action-needed {
    background-color: rgba(255, 214, 82, 0.95);
    color: #1e1e1e;
    border-color: #ffd652;
    -unity-font-style: bold;
}

.mcp-inline-button {
    min-width: 150px;
    margin-left: 6px;
    margin-right: 0;
}

.mcp-danger-button {
    background-color: rgba(160, 20, 20, 0.85);
    color: #ffffff;
    border-color: var(--mcp-error);
}

.mcp-indicator {
    width: 22px;
    min-width: 22px;
    margin-top: 1px;
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-center;
}

.mcp-indicator--ok {
    color: var(--mcp-ok);
}

.mcp-indicator--warn {
    color: var(--mcp-warn);
}

.mcp-indicator--error {
    color: var(--mcp-error);
}

.mcp-indicator--optional {
    color: var(--mcp-text-muted);
}

.mcp-status-line {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.mcp-status-text {
    flex-grow: 1;
    white-space: normal;
}

.mcp-log {
    white-space: normal;
    color: var(--mcp-text-muted);
    max-height: 42px;
    overflow: hidden;
}

.mcp-command-list {
    height: 220px;
    margin-top: 4px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.mcp-command-row {
    border-left-width: 3px;
    border-left-color: var(--mcp-info);
    padding-left: 6px;
    padding-right: 6px;
    white-space: nowrap;
}

.mcp-command-row--allow {
    border-left-color: var(--mcp-ok);
}

.mcp-command-row--ask {
    border-left-color: var(--mcp-warn);
}

.mcp-command-row--deny {
    border-left-color: var(--mcp-error);
}

.mcp-command-row--unknown {
    border-left-color: var(--mcp-optional);
}

.mcp-command-row--feature-hidden {
    border-left-color: var(--mcp-info);
    color: var(--mcp-info);
}

.mcp-policy-action-field {
    border-left-width: 3px;
    border-left-color: var(--mcp-warn);
    padding-left: 4px;
}

.mcp-policy-action--allow {
    border-left-color: var(--mcp-ok);
}

.mcp-policy-action--ask {
    border-left-color: var(--mcp-warn);
}

.mcp-policy-action--deny {
    border-left-color: var(--mcp-error);
}

.mcp-policy-action--none {
    border-left-color: var(--mcp-optional);
}

.mcp-policy-action--unknown {
    border-left-color: var(--mcp-info);
}
